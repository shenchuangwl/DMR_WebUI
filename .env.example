# ============================================================
# DMR量化交易系统 - 环境变量示例
# 用法：复制为 .env 并填入真实值；.env 已被 .gitignore 忽略
#   cp .env.example .env
# 或直接导出到环境：
#   export BINANCE_API_KEY=...
# ============================================================

# ---------- Binance 实盘 API 凭证（必填，否则启动即失败）----------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- Binance 测试网凭证（可选）----------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ============================================================
# 账户设置写入开关（⚠️ 高风险，默认关闭）
# 置为 1 时，程序会在开仓前改写你账户的杠杆与保证金模式：
#   - 杠杆：DMR_LEVERAGE（默认 10 倍）
#   - 保证金模式：DMR_MARGIN_TYPE（默认 CROSSED 全仓）
# 全仓模式下爆仓会波及整个账户余额；10 倍杠杆的强平距离约为 5 倍的一半。
# 该改写会影响同一账户下的其他持仓与风控设置，请确认后再开启。
# ============================================================
DMR_APPLY_ACCOUNT_SETTINGS=0
DMR_LEVERAGE=10
DMR_MARGIN_TYPE=CROSSED

# ============================================================
# 实盘写操作守卫（⚠️ 默认保持 0）
# 该变量供内部测试脚本使用；相关脚本目录（A_TEST/）不随公开仓库发布。
# 保留此变量是为了与本地开发环境保持一致：任何读取它的代码，
# 都应在其值不为 1 时拒绝发起下单/撤单等写请求。
# ============================================================
DMR_ALLOW_LIVE=0
