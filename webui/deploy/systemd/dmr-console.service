# DMR WebUI 控制台（NiceGUI）的用户级单元模板。只绑回环 127.0.0.1:18210。本轮不安装。
# 安装：把 @WEBUI_ROOT@ 换成 webui 目录的绝对路径后放进 ~/.config/systemd/user/（步骤见 deploy/README.md）。
#
# 与内核只是启动先后关系（Wants/After），不连带：重启控制台不影响内核，内核停了控制台照样起得来（提示改用命令行应急入口）。
[Unit]
Description=DMR WebUI 控制台（仅回环 127.0.0.1:18210）
Documentation=file:@WEBUI_ROOT@/deploy/README.md
Wants=dmr-kernel.service
After=dmr-kernel.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@WEBUI_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=DMR_VAR_DIR=@WEBUI_ROOT@/var
Environment=DMR_CONSOLE_HOST=127.0.0.1
Environment=DMR_CONSOLE_PORT=18210
Environment=DMR_KERNEL_HOST=127.0.0.1
Environment=DMR_KERNEL_PORT=18200
ExecStart=@WEBUI_ROOT@/.venv-console/bin/python -m dmr_console
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=default.target
